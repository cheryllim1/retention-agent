{"metadata": {"dbt_schema_version": "https://schemas.getdbt.com/dbt/run-results/v6.json", "dbt_version": "1.12.6", "generated_at": "2026-10-29T20:00:14.737211Z", "invocation_id": "1c4e1333-7dbd-44af-8dcb-81f1f74774c4", "invocation_started_at": "2026-10-29T20:00:01.367323Z", "env": {}}, "results": [{"status": "success", "timing": [{"name": "compile", "started_at": "2026-10-29T20:00:13.987630Z", "completed_at": "2026-10-29T20:00:14.013754Z"}, {"name": "execute", "started_at": "2026-10-29T20:00:14.015879Z", "completed_at": "2026-10-29T20:00:14.272252Z"}], "thread_id": "Thread-1 (worker)", "execution_time": 0.29256200790405273, "adapter_response": {"_message": "OK"}, "message": "OK", "failures": null, "unique_id": "model.churn_analytics.dim_customers", "compiled": true, "compiled_code": "WITH customer_orders AS (\r\n    SELECT\r\n        \"User_ID\" AS customer_id,\r\n        MAX(CAST(\"Purchase_Date\" AS DATE)) AS last_purchase_date,\r\n        COUNT(*) AS total_orders,\r\n        SUM(CAST(\"Final_Price(Rs.)\" AS DOUBLE)) AS total_spend,\r\n        AVG(CAST(\"Discount (%)\" AS DOUBLE)) AS avg_discount_used\r\n    FROM raw_orders\r\n    WHERE \"User_ID\" IS NOT NULL\r\n    GROUP BY \"User_ID\"\r\n)\r\n\r\nSELECT\r\n    customer_id,\r\n    total_orders,\r\n    ROUND(total_spend, 2) AS total_spend,\r\n    ROUND(avg_discount_used, 2) AS avg_discount_used,\r\n    last_purchase_date,\r\n    DATEDIFF('day', last_purchase_date, (SELECT MAX(CAST(\"Purchase_Date\" AS DATE)) FROM raw_orders)) AS days_since_last_order,\r\n    CASE \r\n        WHEN DATEDIFF('day', last_purchase_date, (SELECT MAX(CAST(\"Purchase_Date\" AS DATE)) FROM raw_orders)) > 180 THEN 'High Churn Risk'\r\n        WHEN DATEDIFF('day', last_purchase_date, (SELECT MAX(CAST(\"Purchase_Date\" AS DATE)) FROM raw_orders)) BETWEEN 90 AND 180 THEN 'Medium Churn Risk'\r\n        ELSE 'Active'\r\n    END AS churn_risk_status\r\nFROM customer_orders", "relation_name": "\"analytics\".\"main\".\"dim_customers\"", "batch_res